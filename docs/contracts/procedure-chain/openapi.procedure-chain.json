            "name": "pid",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Pid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DelegationApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/responseEnvelope"
                    }
                  ],
                  "properties": {
                    "data": {
                      "$ref": "delegation-apply.schema.json"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            },
            "description": "成功：data 见 x-contract.response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/responseEnvelope"
                    }
                  ],
                  "properties": {
                    "message": {
                      "anyOf": [
                        {
                          "$ref": "delegation-apply.schema.json#/$defs/rejection"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "description": "请求被拒（委派被拒时 message 带 reason / cycles）"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/responseEnvelope"
                    }
                  ],
                  "properties": {
                    "message": {
                      "anyOf": [
                        {
                          "$ref": "delegation-apply.schema.json#/$defs/conflictError"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "description": "冲突：已被他人分配、凭证已消费 / 过期 / 被篡改、目标版本已变化"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.schema.json#/$defs/validationErrorBody"
                }
              }
            },
            "description": "请求参数校验失败"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/responseEnvelope"
                    }
                  ],
                  "properties": {
                    "message": {
                      "$ref": "trimmed-scope.schema.json#/$defs/unavailable"
                    }
                  }
                }
              }
            },
            "description": "读不到粗裁结果，停止执行（fail-closed）"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delegation Apply",
        "tags": [
          "procedure-chain"
        ],
        "x-contract": {
          "errors": {
            "400": [
              "delegation-apply.schema.json#/$defs/rejection",
              "string"
            ],
            "409": [
              "delegation-apply.schema.json#/$defs/conflictError",
              "string"
            ],
            "503": [
              "trimmed-scope.schema.json#/$defs/unavailable"
            ]
          },
          "request": "delegation-apply.schema.json#/$defs/request",
          "response": "delegation-apply.schema.json"
        }
      }
    },
