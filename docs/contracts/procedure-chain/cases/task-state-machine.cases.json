{
  "contract": "procedure-task-event.schema.json",
  "description": "程序行任务状态机共享用例（workflow × applicability）。from = 转换前任务：workflow / applicability / wp（是否已绑定底稿）/ assignee / reviewer（是否已有执行人 / 复核人，staff 记号 A / R）。action 参数：assign / reassign 的新执行人为 B，set_reviewer 的新复核人为 R2；reassign 理由 ≥5 字；submit 带执行说明与证据快照；cancel 理由必填。expect：成功给 workflow / applicability / changed / 版本增量 / 历史（null = 业务 no-op，不写历史与 outbox）；失败给 error（HTTP 状态，零副作用）。actor_role：delegator 委派人 / assignee 执行人 / reviewer 复核人。",
  "cases": [
    { "name": "assign 首次分配", "from": { "workflow": "unassigned", "applicability": "execute" }, "action": "assign", "actor_role": "delegator",
      "expect": { "workflow": "assigned", "applicability": "execute", "changed": true, "assignment_version_delta": 1, "lock_version_delta": 1,
                  "history": { "event_type": "assigned", "from_status": "unassigned", "to_status": "assigned" } } },
    { "name": "assign 只允许 unassigned", "from": { "workflow": "assigned", "applicability": "execute", "assignee": "A" }, "action": "assign", "actor_role": "delegator", "expect": { "error": 409 } },
    { "name": "assign 不适用的任务不可分配", "from": { "workflow": "unassigned", "applicability": "not_applicable" }, "action": "assign", "actor_role": "delegator", "expect": { "error": 409 } },
    { "name": "assign 只给委派人", "from": { "workflow": "unassigned", "applicability": "execute" }, "action": "assign", "actor_role": "assignee", "expect": { "error": 409 } },
    { "name": "acknowledge 确认", "from": { "workflow": "assigned", "applicability": "execute", "assignee": "A" }, "action": "acknowledge", "actor_role": "assignee",
      "expect": { "workflow": "acknowledged", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "acknowledged", "from_status": "assigned", "to_status": "acknowledged" } } },
    { "name": "acknowledge 重复确认为 no-op", "from": { "workflow": "acknowledged", "applicability": "execute", "assignee": "A" }, "action": "acknowledge", "actor_role": "assignee",
      "expect": { "workflow": "acknowledged", "applicability": "execute", "changed": false, "assignment_version_delta": 0, "lock_version_delta": 0, "history": null } },
    { "name": "acknowledge 未分配 409", "from": { "workflow": "unassigned", "applicability": "execute" }, "action": "acknowledge", "actor_role": "assignee", "expect": { "error": 409 } },
    { "name": "start 开始执行", "from": { "workflow": "acknowledged", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "start", "actor_role": "assignee",
      "expect": { "workflow": "in_progress", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "started", "from_status": "acknowledged", "to_status": "in_progress" } } },
    { "name": "start 退回后重新开始", "from": { "workflow": "changes_requested", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "start", "actor_role": "assignee",
      "expect": { "workflow": "in_progress", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "started", "from_status": "changes_requested", "to_status": "in_progress" } } },
    { "name": "start 未确认 409", "from": { "workflow": "assigned", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "start", "actor_role": "assignee", "expect": { "error": 409 } },
    { "name": "start 底稿未生成 409", "from": { "workflow": "acknowledged", "applicability": "execute", "wp": false, "assignee": "A" }, "action": "start", "actor_role": "assignee", "expect": { "error": 409 } },
    { "name": "submit 提交", "from": { "workflow": "in_progress", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "submit", "actor_role": "assignee",
      "expect": { "workflow": "submitted", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "submitted", "from_status": "in_progress", "to_status": "submitted" } } },
    { "name": "submit 执行说明为空 422", "from": { "workflow": "in_progress", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "submit", "actor_role": "assignee", "args": { "execution_summary": " " }, "expect": { "error": 422 } },
    { "name": "request_changes 退回", "from": { "workflow": "submitted", "applicability": "execute", "wp": true, "assignee": "A", "reviewer": "R" }, "action": "request_changes", "actor_role": "reviewer",
      "expect": { "workflow": "changes_requested", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "changes_requested", "from_status": "submitted", "to_status": "changes_requested" } } },
    { "name": "review 复核通过", "from": { "workflow": "submitted", "applicability": "execute", "wp": true, "assignee": "A", "reviewer": "R" }, "action": "review", "actor_role": "reviewer",
      "expect": { "workflow": "reviewed", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "reviewed", "from_status": "submitted", "to_status": "reviewed" } } },
    { "name": "review 没有复核人 409", "from": { "workflow": "submitted", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "review", "actor_role": "reviewer", "expect": { "error": 409 } },
    { "name": "reassign 执行中转派：历史记真实前一状态", "from": { "workflow": "in_progress", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "reassign", "actor_role": "delegator",
      "expect": { "workflow": "assigned", "applicability": "execute", "changed": true, "assignment_version_delta": 1, "lock_version_delta": 1,
                  "history": { "event_type": "reassigned", "from_status": "in_progress", "to_status": "assigned" } } },
    { "name": "reassign 同一人为 no-op", "from": { "workflow": "assigned", "applicability": "execute", "assignee": "B" }, "action": "reassign", "actor_role": "delegator",
      "expect": { "workflow": "assigned", "applicability": "execute", "changed": false, "assignment_version_delta": 0, "lock_version_delta": 0, "history": null } },
    { "name": "reassign 未分配请用 assign", "from": { "workflow": "unassigned", "applicability": "execute" }, "action": "reassign", "actor_role": "delegator", "expect": { "error": 409 } },
    { "name": "reassign 终态 409", "from": { "workflow": "reviewed", "applicability": "execute", "wp": true, "assignee": "A", "reviewer": "R" }, "action": "reassign", "actor_role": "delegator", "expect": { "error": 409 } },
    { "name": "reassign 理由不足 5 字 422", "from": { "workflow": "assigned", "applicability": "execute", "assignee": "A" }, "action": "reassign", "actor_role": "delegator", "args": { "reason": "换人" }, "expect": { "error": 422 } },
    { "name": "set_reviewer 改复核人不改执行版本", "from": { "workflow": "in_progress", "applicability": "execute", "wp": true, "assignee": "A", "reviewer": "R" }, "action": "set_reviewer", "actor_role": "delegator",
      "expect": { "workflow": "in_progress", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "reviewer_changed", "from_status": "in_progress", "to_status": "in_progress" } } },
    { "name": "set_reviewer 终态 409", "from": { "workflow": "cancelled", "applicability": "not_applicable" }, "action": "set_reviewer", "actor_role": "delegator", "expect": { "error": 409 } },
    { "name": "cancel 取消", "from": { "workflow": "in_progress", "applicability": "execute", "wp": true, "assignee": "A" }, "action": "cancel", "actor_role": "delegator",
      "expect": { "workflow": "cancelled", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "cancel", "from_status": "in_progress", "to_status": "cancelled" } } },
    { "name": "cancel 已复核不可取消", "from": { "workflow": "reviewed", "applicability": "execute", "wp": true, "assignee": "A", "reviewer": "R" }, "action": "cancel", "actor_role": "delegator", "expect": { "error": 409 } },
    { "name": "cancel 没有理由 422", "from": { "workflow": "assigned", "applicability": "execute", "assignee": "A" }, "action": "cancel", "actor_role": "delegator", "args": { "reason": "" }, "expect": { "error": 422 } },
    { "name": "cancel 已取消且适用性不变为 no-op", "from": { "workflow": "cancelled", "applicability": "execute" }, "action": "cancel", "actor_role": "delegator",
      "expect": { "workflow": "cancelled", "applicability": "execute", "changed": false, "assignment_version_delta": 0, "lock_version_delta": 0, "history": null } },
    { "name": "cancel 已取消再细裁为不适用", "from": { "workflow": "cancelled", "applicability": "execute" }, "action": "cancel", "actor_role": "delegator", "args": { "set_applicability": "not_applicable" },
      "expect": { "workflow": "cancelled", "applicability": "not_applicable", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "cancel", "from_status": "cancelled", "to_status": "cancelled" } } },
    { "name": "reopen 重开（清执行人、要重新委派）", "from": { "workflow": "cancelled", "applicability": "execute", "assignee": "A" }, "action": "reopen", "actor_role": "delegator",
      "expect": { "workflow": "unassigned", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1, "assignee_cleared": true,
                  "history": { "event_type": "reopen", "from_status": "cancelled", "to_status": "unassigned" } } },
    { "name": "reopen 细裁恢复执行", "from": { "workflow": "cancelled", "applicability": "not_applicable" }, "action": "reopen", "actor_role": "delegator", "args": { "set_applicability": "execute" },
      "expect": { "workflow": "unassigned", "applicability": "execute", "changed": true, "assignment_version_delta": 0, "lock_version_delta": 1,
                  "history": { "event_type": "reopen", "from_status": "cancelled", "to_status": "unassigned" } } },
    { "name": "reopen 只允许已取消", "from": { "workflow": "assigned", "applicability": "execute", "assignee": "A" }, "action": "reopen", "actor_role": "delegator", "expect": { "error": 409 } }
  ]
}
