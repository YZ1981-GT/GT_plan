{
  "contract": "member-scope.schema.json",
  "description": "有效循环范围共享用例。输入：system_role = users.role；staff_count = 该账号未删除的人员档案数；member_rows = 本项目未删除的 project_users 行（每项为 scope_cycles 原值，空列表 = 不是项目成员）；assignments = 挂在第一份人员档案上的团队分配（deleted=true 表示已软删）；index_cycles = 本项目底稿索引里出现的循环。supervisor_roles / standard_cycles 是契约常量（Python 与 Java 必须逐值一致）。",
  "supervisor_roles": [
    "eqcr",
    "manager",
    "partner",
    "qc",
    "signing_partner",
    "合伙人",
    "独立复核合伙人",
    "质控",
    "项目经理"
  ],
  "standard_cycles": [
    "A",
    "B",
    "C",
    "D",
    "E",
    "F",
    "G",
    "H",
    "I",
    "J",
    "K",
    "L",
    "M",
    "N",
    "S"
  ],
