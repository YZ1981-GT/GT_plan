# ============================================================
# gt-sj-plan 环境变量 — sj-dev1.0 分支专用
#
# 配合 docker-compose.sj-plan.yml 使用（推荐 .\scripts\sj-plan.ps1）。
# 只放容器端口与库名；后端（宿主机 start-dev.bat）的连接串写在根 .env。
#
# 🔴 端口一律高于 15000：本机 Hyper-V 动态端口段是 1024–15000，会被随机保留。
#    与 audit-*（15432 / 16379 / 21009）错开。
# ============================================================

# ---- PostgreSQL ----
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=audit_platform_sj
PG_PORT=15433
PGBOUNCER_PORT=16433

# ---- Redis ----
REDIS_PORT=16380

# ---- ONLYOFFICE ----
OFFICE_PORT=21010
ONLYOFFICE_JWT_SECRET=onlyoffice-dev-secret-2026

# ---- 可选服务（默认不启动，端口预先错开）----
METABASE_PORT=23000
