flowchart TB
    subgraph WP["底稿侧（编制真源）"]
        SUM["confirmation-summary<br/>逐笔函证行<br/>checklist_responses"]
        ENT["entity-verify 主体核验"]
        FU["followup 催函"]
        DIFF["diff-reconcile / checklist / securities<br/>差异调节"]
        FRAUD["fraud-risk 舞弊信号"]
        REL["reliability 电子回函可靠性"]
        ALT["alternative-*<br/>替代程序 8 套<br/>createAlternativeConfirmationData"]
    end

    subgraph HUB["台账侧（项目级真源）"]
        TBL["confirmation 表<br/>book_amount / confirmed_amount / status"]
        UI["ConfirmationHub.vue<br/>台账 + 从底稿导入候选"]
        STATS["覆盖率<br/>发函÷TB population"]
    end

    subgraph DOWN["下游科目底稿"]
        D1["D1 应收票据"]
        D2["D2 应收账款"]
        D5["D5 应收款项融资"]
        OTHER["E0/F0/G0/H0/K0/L0 复用"]
    end

    SUM -->|syncHubFromSummary<br/>upsert + 状态机推进| TBL
    UI --> TBL
    TBL --> STATS
    TBL -->|终态 returned/matched/discrepancy| APPLY["apply_confirmation_result"]
    APPLY -->|CONFIRMATION_RECEIVED| STALE["propagate_wp_stale"]
    APPLY -->|eventBus confirmation:received| DOWN
    STALE --> DOWN
    SUM -.->|未回函→替代 / 差异→调节| ALT
    SUM -.->|未回函| FU
    SUM -.->|电子回函| REL
    ALT --> DOWN
    WP -.->|9 componentType 跨循环复用| OTHER
