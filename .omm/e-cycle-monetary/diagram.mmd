flowchart LR
    subgraph SRC["四表库"]
        TB["trial_balance<br/>1001/1002/1012"]
        TBB["tb_balance 叶子科目<br/>现金/银行/其他"]
        TBL["tb_ledger<br/>凭证级收支"]
    end

    subgraph E1["E1 货币资金"]
        DIR["底稿目录"]
        ADJU["E1-1 审定表"]
        CASH["E1-2 现金明细"]
        BANK["E1-3 银行存款明细<br/>rmb / multi"]
        DIGI["E1-4 数字货币"]
        ADJ["E1-5 调整分录"]
        RECON["E1-6 余额调节表"]
        CNT["E1-7/8 现金盘点<br/>E1-9 存单盘点"]
        ACCT["E1-10 账户核对"]
        COMMIT["E1-11 承诺书"]
        ANA["E1-14 分析表"]
        INT["E1-15 利息月度分析<br/>E1-20 应计利息测算"]
        CREDIT["E1-18/19 征信报告"]
        CUT["E1-21/22 截止测试"]
        BIG["E1-23 收支检查"]
        IPO["E1-26~32 IPO/舞弊族"]
        DISC["附注 上市/国企"]
    end

    NOTE["附注 五、1 / 八、1"]
    E0["E0 银行函证<br/>复用 D0 confirmation-*"]
    CFS["现金流量表<br/>期末现金及现金等价物"]

    TBB -->|四表取数 seed<br/>叶子提取+TB公式| CASH
    TBB -->|四表取数 seed| BANK
    TBB -->|四表取数 seed| ACCT
    TBL --> BIG
    TBL --> CUT
    CASH -->|跨sheet聚合键| ADJU
    BANK -->|跨sheet聚合键| ADJU
    DIGI -->|跨sheet聚合键| ADJU
    ADJ -->|按项目调整| ADJU
    ADJU -->|writeback 1001/1002/1012| TB
    ADJU -->|审定分类数| DISC
    DISC --> NOTE
    RECON <-.->|未达账项核对| BANK
    ACCT <-.->|双向差集：清单有/账面无| BANK
    COMMIT -.->|完整性认定| ACCT
    E0 -->|回函按开户行匹配<br/>回写 confirmAmount| BANK
    ADJU -.->|勾稽提示：差额=受限资金+非等价物| CFS
    INT -.->|存量 vs 流量不做等式勾稽| ANA
    IPO -.->|舞弊/IPO 红旗| ADJU
