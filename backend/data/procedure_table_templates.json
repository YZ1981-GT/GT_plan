          ]
        },
        {
          "seq": 4,
          "content": "注意到可能重大错报迹象时，修改风险评估结果和审计计划或更新对被审计单位的了解",
          "ref_index": null,
          "auto_data_source": null,
          "applicable_default": "yes"
        },
        {
          "seq": 5,
          "content": "识别出重大不一致或重大错报时，与管理层讨论并确定",
          "ref_index": null,
          "auto_data_source": null,
          "applicable_default": "yes",
          "sub_items": [
            {
              "seq": "5.1",
              "content": "确定其他信息是否存在重大错报"
            },
            {
              "seq": "5.2",
              "content": "确定财务报表是否存在重大错报"
            },
            {
              "seq": "5.3",
              "content": "确定对被审计单位及其环境的了解是否需要更新"
            }
          ]
        },
        {
          "seq": 6,
          "content": "认为其他信息存在重大错报时，要求管理层更正",
          "ref_index": null,
          "auto_data_source": null,
          "applicable_default": "yes",
          "sub_items": [
            {
              "seq": "6.1",
              "content": "管理层同意更正，确定更正已完成"
            },
            {
              "seq": "6.2",
              "content": "管理层拒绝更正，与治理层沟通并要求更正"
            }
          ]
        },
        {
          "seq": 7,
          "content": "审计报告日前获取的其他信息存在未更正的重大错报时的措施",
          "ref_index": null,
          "auto_data_source": null,
          "applicable_default": "yes",
          "sub_items": [
            {
              "seq": "7.1",
              "content": "考虑对审计报告的影响并与治理层沟通"
            },
            {
              "seq": "7.2",
              "content": "在法律法规允许时考虑解除业务约定"
            }
          ]
        },
        {
          "seq": 8,
          "content": "审计报告日后获取的其他信息存在重大错报时的处理",
          "ref_index": null,
          "auto_data_source": null,
          "applicable_default": "yes",
          "sub_items": [
