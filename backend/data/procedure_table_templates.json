          {"seq": "3.3", "content": "检查与实际控制人或控股股东的大额资金往来"},
          {"seq": "3.4", "content": "对重大或异常客户与供应商进行背景调查"},
          {"seq": "3.5", "content": "检查银行对账单和大额资金往来的商业背景"},
          {"seq": "3.6", "content": "分析异常交易的商业理由、价格公允性及潜在关联方关系"},
          {"seq": "3.7", "content": "向重要股东和关键管理人员函证确认关联方关系"},
          {"seq": "3.8", "content": "检查第三方担保是否存在未披露的反担保"}
        ]},
        {"seq": 4, "content": "执行程序确定是否存在未识别的关联方及交易", "ref_index": null, "auto_data_source": null, "applicable_default": "yes", "sub_items": [
          {"seq": "4.1", "content": "调查访谈实际控制人投资、借贷等情况，取得相关承诺书"},
          {"seq": "4.2", "content": "取得董监高和重要交易对手的利益冲突专项声明"},
          {"seq": "4.3", "content": "比对员工花名册与合同签订人/经办人"},
          {"seq": "4.4", "content": "运用数据分析工具识别异常交易模式"}
        ]},
        {"seq": 5, "content": "对审计中新识别的未披露关联方或交易的后续程序", "ref_index": null, "auto_data_source": null, "applicable_default": "yes", "sub_items": [
          {"seq": "5.1", "content": "与管理层讨论确定是否所有交易已识别"},
          {"seq": "5.2", "content": "评价监控关联方的公司层次控制设计有效性"},
          {"seq": "5.3", "content": "确定关联交易风险应对是否已恰当应对"},
          {"seq": "5.4", "content": "考虑缺少披露是否有意为之，通知合伙人评估审计内涵"}
        ]},
        {"seq": 6, "content": "关联方交易的披露审核", "ref_index": "A7-2", "auto_data_source": "related_party_disclosure_check", "applicable_default": "yes", "sub_items": [
