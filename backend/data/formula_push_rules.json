{
  "version": 1,
  "spec": "chain-closure-phase2-formula-push-engine",
  "note": "公式推送规则清单：目标地址 + 来源公式 + 写入策略 + 触发事件。由 app/services/formula_push/rules.py 加载即校验；公式管理「公式推送」面板只读展示。",
  "rules": [
    {
      "rule_id": "E1.cash_rows.four_table",
      "page_key": "workpaper:E1",
      "stage": "source",
      "policy": "editable",
      "target": {
        "domain": "workpaper",
        "wp_code": "E1",
        "sheet_code": "E1-2",
        "item_id": "E1-cash-detail-rows",
        "rows": "four_table_seeded",
        "fields": [
          "opening",
          "increase",
          "decrease"
        ]
      },
      "source": {
        "kind": "four_table_leaves",
        "slots": [
          "cash"
        ],
        "formula_text": "库存现金（1001）末级科目：期初 = 期初余额，本期增加 = 本期借方，本期减少 = 本期贷方"
      },
      "triggers": [
        "TRIAL_BALANCE_UPDATED",
        "manual"
      ],
      "description": "现金明细表中由四表带入的行（人民币默认行、cash-ft-科目编码 行）随四表刷新期初 / 增加 / 减少；用户改过或锁定的单元格保留"
    },
    {
      "rule_id": "E1.bank_rows.four_table",
      "page_key": "workpaper:E1",
      "stage": "source",
      "policy": "editable",
      "target": {
        "domain": "workpaper",
        "wp_code": "E1",
        "sheet_code": "E1-3",
        "item_id": "E1-bank-detail-rows",
        "rows": "four_table_seeded",
        "fields": [
          "opening",
          "increase",
          "decrease"
        ]
      },
      "source": {
        "kind": "four_table_leaves",
        "slots": [
          "bank",
          "other"
        ],
        "formula_text": "银行存款（1002）末级科目 → 银行机构分组，其他货币资金（1012）末级科目 → 其他货币资金分组：期初 = 期初余额，本期增加 = 本期借方，本期减少 = 本期贷方"
      },
      "triggers": [
        "TRIAL_BALANCE_UPDATED",
        "manual"
      ],
      "description": "银行存款明细表中由四表带入的本金行随四表刷新期初 / 增加 / 减少；用户改过或锁定的单元格保留"
    },
    {
      "rule_id": "E1.tb_amount.ending",
      "page_key": "workpaper:E1",
      "stage": "source",
      "policy": "system",
      "target": {
        "domain": "workpaper",
        "wp_code": "E1",
        "sheet_code": "E1-1",
        "item_id": "E1-adj-tb-amount-ending"
      },
      "source": {
        "kind": "formula",
        "context": {
          "tb": "trial_balance_audited"
        },
        "expression": "TB('1001','期末余额')+TB('1002','期末余额')+TB('1012','期末余额')"
      },
      "triggers": [
        "TRIAL_BALANCE_UPDATED",
        "manual"
      ],
      "description": "审定表「试算平衡表数」期末 = 试算表 1001 / 1002 / 1012 审定数之和（与报表审定数同源；审定表发布到试算表后两者应一致）"
    },
    {
      "rule_id": "E1.tb_amount.opening",
      "page_key": "workpaper:E1",
      "stage": "source",
      "policy": "system",
      "target": {
        "domain": "workpaper",
        "wp_code": "E1",
        "sheet_code": "E1-1",
        "item_id": "E1-adj-tb-amount-opening"
      },
      "source": {
        "kind": "formula",
        "context": {
          "tb": "trial_balance_audited"
        },
        "expression": "TB('1001','年初余额')+TB('1002','年初余额')+TB('1012','年初余额')"
      },
      "triggers": [
        "TRIAL_BALANCE_UPDATED",
        "manual"
      ],
      "description": "审定表「试算平衡表数」期初 = 试算表 1001 / 1002 / 1012 年初余额之和"
    },
