{
  "description": "公式预设库显式种子（新增预设条目）。prefill_formula_mapping / check_presets / wide_table_presets 由 preset_library 适配层读时收敛，不在此重复。本文件仅登记无法从既有源派生的新增预设（如报表勾稽 logic_check、合理性提示 reasonability）。Task 14.3 逐页预设（增量·按循环分批）：试点 D 循环审定表结构（D1/D2/D4 计算行 审定数/变动额/变动率）+ 报表核心页勾稽补全（cross_check 2/4/5，凑齐 7 条）+ 附注核心页报表勾稽（五、4 应收票据 / 五、5 应收账款），引用一律 ACNR addr_id/formula_ref（经 full_resolve/grammar_v1 可解析）；未试点页保留现状（inventory 标 pending 增量推进）。",
  "version": "2025-R1",
  "task_14_3_pilot": {
    "delivery": "增量·按循环分批（未试点页保留现状不回归）",
    "cycles": ["D"],
    "scopes": ["workpaper (D1/D2/D4 审定表)", "report (cross_check 补全)", "note (五、4/五、5 核心页)"],
    "reference_grammar": "ACNR grammar_v1（ROW/TB/WP/PREV/NOTE/SUM_TB），禁裸坐标串",
    "requirements": ["22.1", "22.2", "22.6", "22.7"]
  },
  "usage_guide": {
    "字段说明": {
      "page_key": "页面/sheet 定位键，格式 scope:key（workpaper:{wp_code} / report:{key} / note:{section}）",
      "target_cell": "承载单元（auto_calc 回填目标 / logic_check|reasonability 承载单元），同一 page_key 下唯一",
      "expression": "公式表达式（auto_calc 计算式 / logic_check 条件 / reasonability 触发条件）",
      "formula_type": "三类型之一：auto_calc（计算回填）/ logic_check（产问题清单不改值）/ reasonability（产提醒不改值）",
      "refs": "规范化引用，每项 {\"addr_id\": ...} 或 {\"formula_ref\": ...}，经 ACNR full_resolve 可解析（禁裸坐标串）",
      "source": "来源标识",
      "description": "中文说明（logic_check 不通过 / reasonability 触发时的文案）"
    },
    "去重": "预设库按 (page_key, target_cell) 去重，遵循 seed_note_account_mappings 幂等模式"
  },
