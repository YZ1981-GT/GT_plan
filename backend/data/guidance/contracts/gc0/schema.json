      }
    },
    "_CustomGuidanceHandoff_candidate": {
      "allOf": [
        {
          "$ref": "#/definitions/_CustomGuidanceHandoff_base"
        },
        {
          "type": "object",
          "required": [
            "phase",
            "authority",
            "submittedBy",
            "submittedAt"
          ],
