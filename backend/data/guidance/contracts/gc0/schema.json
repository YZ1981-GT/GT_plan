        "projectId",
        "wpId",
        "wpCode",
        "entryId",
        "sheetUid",
        "sheetCode",
        "mappingVersion",
        "formulaBoundaryVersion",
        "guidanceRevision",
        "sections",
        "staleFingerprint",
        "supersedes",
        "evidence"
      ],
      "properties": {
