  "normalization": [
    {
      "case": "全角数字与大写字母",
      "input": "９１１１００００７１０９３０４５１Ｄ",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "全角数字与全角小写字母",
      "input": "９１１１００００７１０９３０４５１ｄ",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "首尾半角空格与小写字母",
      "input": " 91110000710930451d ",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "小写字母",
      "input": "91110000710930451d",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "首尾制表符",
      "input": "\t91110000710930451D\t",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "首尾全角空格（NFKC 后为半角空格再去除）",
      "input": "\u300091110000710930451D\u3000",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "首尾不间断空格（NFKC 后为半角空格再去除）",
      "input": "\u00a091110000710930451D\u00a0",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "带圈数字（NFKC 兼容字符）",
      "input": "9①110000710930451D",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "中间半角空格，长度 19（保持原样）",
      "input": "91110000 710930451D",
      "expected": "91110000 710930451D",
      "expected_valid": false,
      "expected_message": "统一社会信用代码必须为 18 位"
    },
    {
      "case": "中间半角空格，长度 18（保持原样）",
      "input": "91110000 10930451D",
      "expected": "91110000 10930451D",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "中间全角空格，NFKC 后为半角空格（保持原样）",
      "input": "91110000\u300010930451D",
      "expected": "91110000 10930451D",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "字符集外大写字母 O（保持原样）",
      "input": "9111000O710930451D",
      "expected": "9111000O710930451D",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "字符集外小写字母 o（大写后为 O）",
      "input": "9111000o710930451D",
      "expected": "9111000O710930451D",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "字符集外全角字母 Ｉ（NFKC 后为 I）",
      "input": "９１１１００００７１０９３０４５１Ｉ",
      "expected": "91110000710930451I",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "全角句号（非 USCC 字符）",
      "input": "91110000710930451。",
      "expected": "91110000710930451。",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "全角字母 NFKC 后不足 18 位",
      "input": "ａｂｃｄｅｆｇｈｊｋｌｍｎｐ",
      "expected": "ABCDEFGHJKLMNP",
      "expected_valid": false,
      "expected_message": "统一社会信用代码必须为 18 位"
    },
    {
      "case": "仅半角空格，空值 None",
      "input": "   ",
      "expected": null,
      "expected_valid": false,
      "expected_message": "统一社会信用代码必须为 18 位"
    },
    {
      "case": "仅全角空格，空值 None",
      "input": "\u3000",
      "expected": null,
      "expected_valid": false,
      "expected_message": "统一社会信用代码必须为 18 位"
    },
    {
      "case": "仅制表符与换行，空值 None",
      "input": "\t\n ",
      "expected": null,
      "expected_valid": false,
      "expected_message": "统一社会信用代码必须为 18 位"
    },
    {
      "case": "空串，空值 None",
      "input": "",
      "expected": null,
      "expected_valid": false,
      "expected_message": "统一社会信用代码必须为 18 位"
    },
    {
      "case": "null，空值 None",
      "input": null,
      "expected": null,
      "expected_valid": false,
      "expected_message": "统一社会信用代码必须为 18 位"
    },
    {
      "case": "BOM 开头（U+FEFF，JS trim 去除）",
      "input": "\ufeff91110000710930451D",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "U+001C 开头、17 位有效字符（JS trim 不去除，保留并按字符集拒绝）",
      "input": "\u001c91110000710930451",
      "expected": "\u001c91110000710930451",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "U+0085 结尾、17 位有效字符（JS trim 不去除，保留并按字符集拒绝）",
      "input": "91110000710930451\u0085",
      "expected": "91110000710930451\u0085",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "U+2028 与 U+2029 分置两侧（LineTerminator，去除）",
      "input": "\u202891110000710930451D\u2029",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    },
    {
      "case": "U+180E 位于 17 位合法前缀之前（非 WhiteSpace，保留并按字符集拒绝）",
      "input": "\u180e91110000710930451",
      "expected": "\u180e91110000710930451",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "U+200B 位于 17 位合法前缀之后（非 WhiteSpace，保留并按字符集拒绝）",
      "input": "91110000710930451\u200b",
      "expected": "91110000710930451\u200b",
      "expected_valid": false,
      "expected_message": "统一社会信用代码只能包含数字与大写字母（不含 I、O、Z、S、V）"
    },
    {
      "case": "U+0009 开头、U+000D 结尾（去除）",
      "input": "\u000991110000710930451D\u000d",
      "expected": "91110000710930451D",
      "expected_valid": true,
      "expected_message": null
    }
  ]
}
