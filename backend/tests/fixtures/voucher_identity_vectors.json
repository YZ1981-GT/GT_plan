  {"name": "去首尾空白、日期截取到日", "input": {"year": 2025, "company_code": " 001 ", "voucher_date": "2025-12-31T00:00:00", "voucher_type": " 转 ", "voucher_no": " 0099 ", "account_code": " 1122 ", "debit_amount": "500", "credit_amount": "", "occ": 1},
