  {"name": "全角空格、不换行空格与控制字符按 Python str.strip 口径去掉", "input": {"year": 2025, "company_code": "001", "voucher_date": "2025-04-30", "voucher_type": "\u3000转\u001f", "voucher_no": "\u00a00008", "account_code": "1122", "debit_amount": null, "credit_amount": " 12.5 ", "occ": 0},
   "expect": {"vk": "[\"2025\",\"001\",\"2025-04-30\",\"转\",\"0008\"]", "side": "C", "amount": "12.50", "lfp": "[\"2025\",\"001\",\"2025-04-30\",\"转\",\"0008\",\"1122\",\"C\",\"12.50\",0]"}},
  {"name": "BOM 不算空白，两边都保留（JS trim 会去掉它，前端不能用 trim）", "input": {"year": 2025, "company_code": "\ufeff001", "voucher_date": "2025-04-30", "voucher_type": "转", "voucher_no": "0009", "account_code": "1122", "debit_amount": "1", "credit_amount": null, "occ": 0},
   "expect": {"vk": "[\"2025\",\"\ufeff001\",\"2025-04-30\",\"转\",\"0009\"]", "side": "D", "amount": "1.00", "lfp": "[\"2025\",\"\ufeff001\",\"2025-04-30\",\"转\",\"0009\",\"1122\",\"D\",\"1.00\",0]"}}
