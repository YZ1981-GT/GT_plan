  {"name": "借贷双填为不明，金额取借方", "input": {"year": 2025, "company_code": "001", "voucher_date": "2025-01-01", "voucher_type": "ZJGJ", "voucher_no": "0001", "account_code": "1002", "debit_amount": "1303769.25", "credit_amount": "1303769.25", "occ": 0},
