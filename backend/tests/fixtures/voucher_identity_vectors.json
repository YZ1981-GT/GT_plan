  {"name": "负数五入远离零", "input": {"year": 2025, "company_code": "001", "voucher_date": "2025-03-31", "voucher_type": "记", "voucher_no": "7", "account_code": "2221", "debit_amount": "-0.005", "credit_amount": null, "occ": 0},
