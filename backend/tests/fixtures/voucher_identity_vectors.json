  {"name": "四舍五入按十进制（2.675 → 2.68）", "input": {"year": 2025, "company_code": "001", "voucher_date": "2025-03-31", "voucher_type": "记", "voucher_no": "7", "account_code": "2221", "debit_amount": null, "credit_amount": "2.675", "occ": 0},
