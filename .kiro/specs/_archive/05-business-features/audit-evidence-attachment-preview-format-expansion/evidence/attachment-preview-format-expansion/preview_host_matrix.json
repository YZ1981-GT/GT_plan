{
  "host": "Preview_Host",
  "component": "audit-platform/frontend/src/components/extension/AttachmentPreview.vue",
  "unsupported_copy": "暂不支持预览此格式，请下载后查看",
  "legacy_request_channel": "preview",
  "download_derivation": "fileUrl.replace('/preview','/download')",
  "image_exts_frozen": ["jpg", "jpeg", "png", "gif", "bmp", "webp"],
  "image_exts_explicitly_excluded": ["svg"],
  "word_exts": ["docx", "doc"],
  "excel_exts": ["xlsx", "xls", "csv"],
  "category_hints": ["word", "excel", "image"],
  "cases": [
    {"fileName": "a.docx", "fileType": "word", "branch": "docx", "fetchesPreview": true},
    {"fileName": "a.docx", "fileType": "", "branch": "docx", "fetchesPreview": true},
    {"fileName": "a.doc", "fileType": null, "branch": "docx", "fetchesPreview": true},
    {"fileName": "b.xlsx", "fileType": "excel", "branch": "excel", "fetchesPreview": true},
    {"fileName": "b.xls", "fileType": "", "branch": "excel", "fetchesPreview": true},
    {"fileName": "b.csv", "fileType": "", "branch": "excel", "fetchesPreview": true},
    {"fileName": "c.pdf", "fileType": "", "branch": "pdf", "fetchesPreview": true},
    {"fileName": "c.PDF", "fileType": "", "branch": "pdf", "fetchesPreview": true},
    {"fileName": "c.pdf", "fileType": "pdf", "branch": "pdf", "fetchesPreview": true},
    {"fileName": "d.png", "fileType": "image", "branch": "image", "fetchesPreview": true},
    {"fileName": "d.jpg", "fileType": "", "branch": "image", "fetchesPreview": true},
    {"fileName": "d.webp", "fileType": "", "branch": "image", "fetchesPreview": true},
    {"fileName": "d.bmp", "fileType": "", "branch": "image", "fetchesPreview": true},
    {"fileName": "d.svg", "fileType": "", "branch": "unsupported", "fetchesPreview": false},
    {"fileName": "d.svg", "fileType": "image", "branch": "image", "fetchesPreview": true},
    {"fileName": "e.zip", "fileType": "zip", "branch": "unsupported", "fetchesPreview": false},
    {"fileName": "e.eml", "fileType": "", "branch": "unsupported", "fetchesPreview": false},
    {"fileName": "e.msg", "fileType": "", "branch": "unsupported", "fetchesPreview": false},
    {"fileName": "e.dxf", "fileType": "", "branch": "unsupported", "fetchesPreview": false},
    {"fileName": "e.dwg", "fileType": "", "branch": "unsupported", "fetchesPreview": false},
    {"fileName": "noext", "fileType": "", "branch": "unsupported", "fetchesPreview": false},
    {"fileName": "noext", "fileType": "word", "branch": "docx", "fetchesPreview": true}
  ]
}
