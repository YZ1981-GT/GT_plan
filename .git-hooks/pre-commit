#!/usr/bin/env bash
# pre-commit hook
#
# 检查项：
# 1. gitleaks protect --staged 拦截暂存区密钥泄漏（dev-tooling-modernization spec / Task 2）
# 2. check_file_size.py 文件行数门禁（whitelist 只减不增 / HARD_CAPS 防回弹）
#    —— 与 CI file-size-guard job 同源，本地先拦防止回弹（紧急救急 git commit --no-verify）

set -e

# ── 1. gitleaks 暂存区扫描 ──
if ! command -v gitleaks > /dev/null 2>&1; then
    echo "[pre-commit] ⚠️ gitleaks 未安装，跳过（CI 兜底）"
else
    echo "[pre-commit] 执行 gitleaks 暂存区扫描..."
    if ! gitleaks protect --staged --config .gitleaks.toml --redact; then
        echo ""
        echo "[pre-commit] ❌ gitleaks 检测到暂存区存在疑似密钥泄漏"
        echo "          请移除敏感信息后重新提交"
        echo "          紧急救急：git commit --no-verify"
        exit 1
    fi
    echo "[pre-commit] ✅ gitleaks 扫描通过"
fi

# ── 2. 文件行数门禁 ──
PY=$(command -v python || command -v python3 || true)
if [ -z "$PY" ]; then
    echo "[pre-commit] ⚠️ python 未找到，跳过文件大小门禁（CI 兜底）"
    exit 0
fi

echo "[pre-commit] 执行文件行数门禁..."
if ! "$PY" backend/scripts/check/check_file_size.py; then
    echo ""
    echo "[pre-commit] ❌ 文件行数超限/膨胀（见上方明细）"
    echo "          请拆分文件或抽伴生模块（优先），确有必要再更新 whitelist 基线"
    echo "          紧急救急：git commit --no-verify"
    exit 1
fi
echo "[pre-commit] ✅ 文件行数门禁通过"

# ── 3. UTF-8 完整性检查（暂存的 .vue/.ts/.py 文件）──
echo "[pre-commit] 执行 UTF-8 完整性检查..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(vue|ts|py)$' || true)
if [ -n "$STAGED_FILES" ]; then
    UTF8_FAIL=0
    for f in $STAGED_FILES; do
        if [ -f "$f" ]; then
            # 检测 U+FFFD (EF BF BD) 替换字符
            if "$PY" -c "
import sys
try:
    raw = open(sys.argv[1], 'rb').read()
    count = raw.count(b'\xef\xbf\xbd')
    if count > 0:
        ext = sys.argv[1].rsplit('.', 1)[-1] if '.' in sys.argv[1] else ''
        msg = f'  {sys.argv[1]}: {count} 个 U+FFFD 替换字符'
        if ext == 'vue':
            msg += '（疑似 shell 文本替换破坏，禁用 PowerShell Set-Content/-replace）'
        print(msg)
        sys.exit(1)
except (OSError, IOError):
    pass
sys.exit(0)
" "$f"; then
                :
            else
                UTF8_FAIL=1
            fi
        fi
    done
    if [ "$UTF8_FAIL" -eq 1 ]; then
        echo ""
        echo "[pre-commit] ❌ 检测到 U+FFFD 替换字符（UTF-8 编码被破坏）"
        echo "          请检查文件编码，禁止使用 PowerShell Set-Content/-replace 操作 Vue 文件"
        echo "          紧急救急：git commit --no-verify"
        exit 1
    fi
    echo "[pre-commit] ✅ UTF-8 完整性检查通过"
else
    echo "[pre-commit] ✅ UTF-8 完整性检查通过（无匹配暂存文件）"
fi
exit 0
