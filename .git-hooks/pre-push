#!/usr/bin/env bash
# pre-push hook - 仓库 git 工作流统一治理
# repo-git-workflow-unification spec / Task 2.1
#
# 检查项：
# 0a. INDEX.md 归档路径自动修复（所有模式，在工作树干净硬门之前）：spec 归档后 INDEX 的链接 /
#     活跃表行 / 统计数常漂移。本门先自动修可安全修的部分（链接改向 _archive/、删已归档行、重算统计数），
#     有改动或有需人工项即拒推并给出针对性提示 —— 规则和修复工具在
#     backend/scripts/check/fix_spec_index_archive_paths.py
# 0. push 前工作树完整性硬门（所有模式）
# 0b. 版本标记硬门（所有模式，分离头 worktree 推送也查）：推送新提交时，最新提交上必须有随本次
#     推送的附注标签 vX.Y.Z，说明里写「主要变动：」—— 规则和打标签工具都在 .git-hooks/push_version.py
# 1. 分支命名规约（main / spec/ / work/ / fix/ / release/）
# 2. multi 模式禁止直推 main
# 3. 6 维核查（multi 严格 / single 仅警告）
# 4. 暂存树/HEAD 自洽

set -e

# git 从标准输入传本次推送的引用清单（每行：本地引用 本地sha 远端引用 远端sha），先整段读出来给
# 版本标记门用；后面的检查脚本都不读标准输入。
PUSH_REFS="$(cat)"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"

# 找 Python 路径（Windows + Linux 兼容；临时 worktree 里没有 .venv 时用主工作树的）
# 放在工作树干净硬门之前：归档路径自动修复门（0a）要先用到它。
MAIN_ROOT="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo .git)")"
if [ -f ".venv/Scripts/python.exe" ]; then
    PYTHON=".venv/Scripts/python.exe"
elif [ -f ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
elif [ -f "$MAIN_ROOT/.venv/Scripts/python.exe" ]; then
    PYTHON="$MAIN_ROOT/.venv/Scripts/python.exe"
elif [ -f "$MAIN_ROOT/.venv/bin/python" ]; then
    PYTHON="$MAIN_ROOT/.venv/bin/python"
elif command -v python > /dev/null; then
    PYTHON="python"
else
    PYTHON=""
fi

# 0a. INDEX.md 归档路径自动修复硬门（2026-11-08 用户要求：推送时自动修复归档路径变更问题，避免出错）
#
# spec 归档时目录从 `.kiro/specs/<name>/` 移进 `_archive/NNN-<name>/`，但 INDEX.md 的速递区链接 /
# 活跃表行 / 统计数常常没跟着改。本门**先自动修**可安全修的三类漂移（链接改向 / 删已归档行 / 重算统计数），
# 修完后若工作树产生了改动（或仍有需人工处理的项），就拒推并给出针对性提示 —— 而不是让它掉进下面
# 的「工作树干净」硬门报一句笼统的「有未提交文件」。自动改动经用户 git add + commit 后随本次推送上去：
# 工具替你改好字节，你只需提交，既不自动改 HEAD/版本标签，也不会把漂移推上去。
#
# 分离头临时 worktree 推送（并发会话常用）不跑这道门：那里不一定有本工具、也不该在推送瞬间改 INDEX。
FIX_TOOL="backend/scripts/check/fix_spec_index_archive_paths.py"
if [ -n "$PYTHON" ] && [ -f "$FIX_TOOL" ] && [ -f ".kiro/specs/INDEX.md" ]; then
    INDEX_BEFORE="$(git hash-object .kiro/specs/INDEX.md 2>/dev/null || echo before)"
    set +e
    PYTHONIOENCODING=utf-8 "$PYTHON" "$FIX_TOOL" --apply
    ARCHIVE_RC=$?
    set -e
    INDEX_AFTER="$(git hash-object .kiro/specs/INDEX.md 2>/dev/null || echo after)"
    if [ "$INDEX_BEFORE" != "$INDEX_AFTER" ]; then
        echo ""
        echo "[pre-push] ❌ 已自动修复 INDEX.md 的归档路径漂移（链接 / 活跃表行 / 统计数），拒绝本次 push"
        echo "          修好的内容还在工作树里，请提交后重新推送："
        echo "            git add .kiro/specs/INDEX.md && git commit -m \"chore(spec): 归档路径自动修复\""
        echo "          紧急救急：git push --no-verify"
        exit 1
    fi
    if [ "$ARCHIVE_RC" -ne 0 ]; then
        echo ""
        echo "[pre-push] ❌ INDEX.md 仍有需人工处理的归档 / 登记项（见上），拒绝 push"
        echo "          （新建 spec 要在活跃表登记一行 / mojibake 需显式 UTF-8 还原 / 速递区无记录的归档行先补记）"
        echo "          紧急救急：git push --no-verify"
        exit 1
    fi
    echo "[pre-push] ✅ INDEX.md 归档路径一致"
fi

# 0. 交付防丢硬门：push 时工作树必须完全干净。
#
# pre-commit 只看已暂存文件；如果使用 `git add -u` 或只 add 已知路径，新建的文档、
# 迁移、模型和测试会留在 untracked，随后永远不会出现在远端。这个检查必须独立于
# GIT_MODE：single/multi 只影响协作策略，不能放宽交付完整性。
WORKTREE_STATUS="$(git status --porcelain=v1 --untracked-files=all)"
if [ -n "$WORKTREE_STATUS" ]; then
    echo "[pre-push] ❌ 工作树仍有未提交、已暂存或未跟踪文件，拒绝 push"
    echo ""
    printf '%s\n' "$WORKTREE_STATUS"
    echo ""
    echo "处置：确认本次交付文件均已 git add + commit，再重新 push。"
    echo "      若这些文件属于并发任务，请改用独立 git worktree/分支，不要共享工作树。"
    exit 1
fi

# Python 路径：0a 已尝试解析（$PYTHON）。这里只在 0a 没找到（真的缺 Python）时按同一顺序再解析一次，
# 以触发原有的「未找到 Python 拒推」致命分支 —— 版本标记门（0b）必须有 Python 才能跑。
if [ -z "$PYTHON" ]; then
    if [ -f ".venv/Scripts/python.exe" ]; then
        PYTHON=".venv/Scripts/python.exe"
    elif [ -f ".venv/bin/python" ]; then
        PYTHON=".venv/bin/python"
    elif [ -f "$MAIN_ROOT/.venv/Scripts/python.exe" ]; then
        PYTHON="$MAIN_ROOT/.venv/Scripts/python.exe"
    elif [ -f "$MAIN_ROOT/.venv/bin/python" ]; then
        PYTHON="$MAIN_ROOT/.venv/bin/python"
    elif command -v python > /dev/null; then
        PYTHON="python"
    else
        echo "[pre-push] ❌ 未找到 Python，无法校验版本标签，拒绝 push"
        exit 1
    fi
fi

# 0b. 版本标记硬门（2026-10-27 用户要求：推送时要标记版本号和变动的主要内容）
#
# 放在下面的「分离头跳过」之前：并发会话大多在临时分离头 worktree 里推送，跳过就等于没有这道门。
# 校验逻辑在 push_version.py（install.ps1 把它和本钩子一起复制进 .git/hooks/），同一个文件也是
# 打标签 + 推送的工具：python .git-hooks/push_version.py push -c "主要变动一" -c "主要变动二"
if [ ! -f "$HOOK_DIR/push_version.py" ]; then
    echo "[pre-push] ❌ 缺少 $HOOK_DIR/push_version.py（钩子没装全），拒绝 push"
    echo "          在仓库根执行：powershell -ExecutionPolicy Bypass -File .git-hooks/install.ps1"
    exit 1
fi
if ! printf '%s\n' "$PUSH_REFS" | PYTHONIOENCODING=utf-8 "$PYTHON" "$HOOK_DIR/push_version.py" check-push "$1" "$2"; then
    exit 1
fi

GIT_MODE="${GIT_MODE:-single}"
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

if [ -z "$BRANCH" ]; then
    echo "[pre-push] 无法获取分支名（detached HEAD？），跳过其余检查"
    exit 0
fi

echo "[pre-push] 分支: $BRANCH | 模式: $GIT_MODE"

# 1. 命名规约
if ! "$PYTHON" backend/scripts/check/check_git_branch_naming.py "$BRANCH"; then
    echo "[pre-push] ❌ 分支命名不合规，拒绝 push"
    echo "          紧急救急：git push --no-verify"
    exit 1
fi

# 2. multi 模式禁直推 main
if [ "$GIT_MODE" = "multi" ] && [ "$BRANCH" = "main" ]; then
    echo "[pre-push] ❌ multi 模式禁止直推 main，必须走 PR"
    echo "          gh pr create --base main --title '...'"
    echo "          紧急救急：git push --no-verify"
    exit 1
fi

# 3. 6 维核查（multi 严格 / single 仅警告）
if [ "$GIT_MODE" = "multi" ]; then
    if ! "$PYTHON" backend/scripts/check/check_git_sync_state.py --for-push --quiet; then
        echo "[pre-push] ❌ 6 维核查失败（multi 模式严格）"
        "$PYTHON" backend/scripts/check/check_git_sync_state.py --for-push
        exit 1
    fi
else
    "$PYTHON" backend/scripts/check/check_git_sync_state.py --quiet || \
        echo "[pre-push] ⚠️ 6 维核查有项不达标（single 模式仅警告）"
fi

# 4. 暂存树/HEAD 自洽（2026-09-28 新增，spec d1-sync-row-table-engine-and-d1-coverage X5-i）
#
# 🔴 守的是「工作树绿 ≠ 提交后绿」这一类：digest 基线随某轮提交入库了，而对应的 6 个
#    provider 改动留在工作树 ⇒ 工作树上 golden digest 门 exit 0（两边都是新的），
#    HEAD 上 exit 1（基线新、代码旧）。pre-commit 的各门都读工作树，永远绿；CI 要等
#    push 之后 —— 而那 6 个 provider 从没进过任何 commit，CI 从来没机会看到它们。
#
# push 前暂存区通常已清空（index == HEAD），所以这一步实质是在验「即将推送的代码自洽」。
# 用 `git checkout-index` 把 index 物化到临时目录后跑门，约 35~40 秒；push 频率低，可接受。
# 4b. import 健康检查（2026-11-08 新增）—— 拦截缺失模块 / 不存在的导入名 / 前端死注册
#
# 后端：AST 扫描 from app.xxx import yyy，验证模块存在且名字可达
# 前端：components.d.ts 注册的组件文件必须存在
echo "[pre-push] 执行 import 健康检查..."
if ! "$PYTHON" backend/scripts/check/check_import_health.py --root .; then
    echo ""
    echo "[pre-push] ❌ import 健康检查失败 —— 推上去协作者拉取会报红"
    echo "          排查：python backend/scripts/check/check_import_health.py --root ."
    echo "          紧急救急：git push --no-verify"
    exit 1
fi

echo "[pre-push] 执行暂存树自洽检查（物化 index 后跑零回归门，约 40s）..."
if ! "$PYTHON" backend/scripts/check/check_staged_tree_self_consistency.py; then
    echo ""
    echo "[pre-push] ❌ 暂存树自洽检查失败 —— 推上去别人会拉到一棵跑不通的树"
    echo "          常见成因：基线/生成物已入库而对应实现没入库（或反之）"
    echo "          排查：python backend/scripts/check/check_staged_tree_self_consistency.py --keep"
    echo "          紧急救急：git push --no-verify"
    exit 1
fi

echo "[pre-push] ✅ 全部通过"
exit 0
