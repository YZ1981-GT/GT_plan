# ============================================================
# sw-plan 环境变量 — sw-dev1.0 分支（税务 demo）专用
#
# 配合 docker-compose.sw-plan.yml 使用：
#   docker compose -p sw-plan --env-file .env.sw-plan \
#     -f docker-compose.yml -f docker-compose.sw-plan.yml up -d
#
# 🔴 所有宿主端口一律 +100 偏移，与 dev1.0（根 .env）错开。
#    dev1.0 的 audit-* 容器常驻运行，端口相同会直接抢占失败。
# 🔴 启动命令漏掉 --env-file 就会套用根 .env 的默认端口 ⇒ 冲突。
# ============================================================

# ---- PostgreSQL ----
# 库名也改掉：即使误连同一实例，也不会读写 dev1.0 的 audit_platform
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=sw_audit_platform
PG_PORT=5532
PGBOUNCER_PORT=6532

# ---- Redis ----
REDIS_PORT=6479

# ---- ONLYOFFICE ----
OFFICE_PORT=8180
ONLYOFFICE_JWT_SECRET=onlyoffice-dev-secret-2026
ONLYOFFICE_URL=http://onlyoffice:80
WOPI_BASE_URL=http://backend:8000/wopi

# ---- 应用端口（宿主机进程，非容器）----
# sw-dev1.0 专用：后端 6601 / 前端 5001（dev1.0 用 9980 / 3030）
SW_BACKEND_PORT=6601
SW_FRONTEND_PORT=5001

# ---- 其余可选服务（默认 profile 不启动，端口同样预先错开备用）----
METABASE_PORT=3100
METABASE_EMBEDDING_SECRET=audit-metabase-secret-key
PAPERLESS_PORT=8110
VLLM_PORT=8200
VLLM_EMBED_PORT=8201
MINERU_ROUTER_PORT=8102
MINERU_WEBUI_PORT=7960
OLLAMA_PORT=11534

# ---- JWT / 加密（与 dev1.0 同值，便于复用已签发 token；需隔离可自行改）----
JWT_SECRET_KEY=46cb2312aa4267dde33a4f457de1dae45760bf843b7a6f0250d70d2d1bd4e158
ENCRYPTION_KEY=dZBLImBVaLtvB26ucGhm2_whsWpDr2fKmt-Xa7KdK3A=

# ---- 底稿 AI 引擎总开关 ----
WP_AI_SERVICE_ENABLED=True

# ---- 存储（与 dev1.0 共用仓库目录；需完全隔离可改成 ./storage-sw）----
STORAGE_ROOT=./storage
ATTACHMENT_PRIMARY_STORAGE=local
ATTACHMENT_FALLBACK_TO_LOCAL=true
ATTACHMENT_LOCAL_STORAGE_ROOT=./storage/attachments
