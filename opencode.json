{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM Local",
      "options": {
        "baseURL": "http://localhost:8100/v1",
        "apiKey": "dummy"
      },
      "models": {
        "Kbenkhaled/Qwen3.5-27B-NVFP4": {
          "name": "Qwen3.5-27B-NVFP4"
        }
      }
    }
  },
  "model": "vllm/Kbenkhaled/Qwen3.5-27B-NVFP4",
  "lsp": {
    "typescript": {
      "command": ["npx", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "vue": {
      "command": ["npx", "@vue/language-server", "--stdio"],
      "extensions": [".vue"]
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph.cmd", "serve", "--mcp", "--no-watch"],
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://postgres:postgres@localhost:5432/audit_platform"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "D:\\GT_plan"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true
    }
  },
  "plugin": []
}

