    "src/composables/useAiNoteCapture.ts",
    "src/composables/useMountOnFirstOpen.ts",
    "src/composables/__tests__/useMountOnFirstOpen.spec.ts",
    "src/components/ai/ChatNoteSaveDialog.vue",
    "src/components/workpaper/composables/useD3VoucherCheck.ts",
    "src/components/workpaper/d3/D3VoucherCheckDialog.vue",
    "src/views/composables/useNoteSaveFlow.ts",
    "src/views/composables/__tests__/useNoteSaveFlow.spec.ts",
    "src/views/composables/useNoteRefresh.ts",
    "src/views/composables/__tests__/useNoteRefresh.spec.ts",
    "src/services/commonApi.ts",
    "src/composables/__tests__/useEditorSave.spec.ts",
    "src/components/formula/composables/useCrossCheckRules.ts",
    "src/components/formula/composables/__tests__/useCrossCheckRules.spec.ts",
    "src/views/composables/useReportMapping.ts",
    "src/components/disclosure/NoteReadinessPanel.vue",
    "src/components/disclosure/noteStaleSource.ts",
    "src/components/disclosure/__tests__/noteStaleSource.spec.ts",
    "src/__tests__/writeRequestValidateStatusGuard.spec.ts",
    "src/env.d.ts"
  ]
}
