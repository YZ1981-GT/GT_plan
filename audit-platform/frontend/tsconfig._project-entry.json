{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "moduleDetection": "force",
    "jsx": "preserve", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/*"] }, "baseUrl": "."
  },
  "include": [
    "src/constants/projectStages.ts",
    "src/components/layout/ProjectEntryBar.vue",
    "src/views/ProjectEntryHome.vue",
    "src/views/TaxReturnPage.vue",
    "src/views/TaxAuditReportPage.vue",
    "src/views/ProjectListHome.vue",
    "src/composables/reportActiveTab.ts",
    "src/constants/taxAuditReportTemplate.ts",
    "src/components/common/GtPageHeader.vue",
    "src/env.d.ts"
  ]
}
