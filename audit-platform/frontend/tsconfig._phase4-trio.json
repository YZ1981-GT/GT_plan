{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "moduleDetection": "force",
    "jsx": "preserve", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["element-plus/global"],
    "paths": { "@/*": ["./src/*"] }, "baseUrl": "."
  },
  "include": [
    "src/services/apiPaths/report.ts",
    "src/services/deliverableApi.ts",
    "src/components/deliverable/TrioRetryPanel.vue",
    "src/components/deliverable/__tests__/TrioRetryPanel.spec.ts",
    "src/views/DeliverableCenter.vue",
    "src/env.d.ts"
  ]
}
