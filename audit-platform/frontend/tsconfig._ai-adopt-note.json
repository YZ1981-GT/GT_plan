{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "moduleDetection": "force",
    "jsx": "preserve", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/*"] }, "baseUrl": "."
  },
  "include": [
    "src/composables/aiChatWireError.ts",
    "src/services/auditPlatformApi.ts",
    "src/composables/useAiHostContext.ts",
    "src/composables/usePlatformAiChat.ts",
    "src/composables/useAiNoteCapture.ts",
    "src/components/ai/chatTargetOptions.ts",
    "src/components/ai/ChatAdoptTargetDialog.vue",
    "src/components/ai/ChatNoteSaveDialog.vue",
    "src/components/ai/PlatformAiChatPanel.vue",
    "src/components/ai/AiContentPendingBanner.vue",
    "src/components/ai/__tests__/ChatAdoptNoteTarget.spec.ts",
    "src/components/ai/__tests__/AiContentPendingBanner.spec.ts",
    "src/utils/eventBus.ts",
    "src/env.d.ts"
  ]
}
