{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "moduleDetection": "force",
    "jsx": "preserve", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/*"] }, "baseUrl": "."
  },
  "include": [
    "src/services/aiModelApi.ts",
    "src/services/aiModelApi.spec.ts",
    "src/services/apiPaths/system.ts",
    "src/components/ai/modelRouteView.ts",
    "src/components/ai/modelRouteView.spec.ts",
    "src/components/ai/ModelRoutePanel.vue",
    "src/components/ai/ModelTable.vue",
    "src/views/AIModelConfig.vue",
    "src/env.d.ts"
  ]
}
