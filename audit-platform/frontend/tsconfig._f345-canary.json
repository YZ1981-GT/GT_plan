{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/components/workpaper/GtF3NotesPayable.vue",
    "src/components/workpaper/GtF4AccountsPayable.vue",
    "src/components/workpaper/GtF5CostOfSales.vue",
    "src/components/workpaper/composables/useF3FormData.ts",
    "src/components/workpaper/composables/useF4FormData.ts",
    "src/components/workpaper/composables/useF5CosSalFormData.ts",
    "src/components/workpaper/composables/f3RowIdentity.ts",
    "src/components/workpaper/composables/useF3RelatedParty.ts",
    "src/components/workpaper/composables/useF3OverdueCheck.ts",
    "src/components/workpaper/composables/useF3VoucherCheck.ts",
    "src/components/workpaper/composables/useF3Detail.ts",
    "src/env.d.ts"
  ]
}
