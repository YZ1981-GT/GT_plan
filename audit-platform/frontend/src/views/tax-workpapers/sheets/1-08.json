      "rows": [
        [{"text":"初步业务活动程序及评价表","kind":"title","colSpan":6}],
        [{},{"text":"索引号：1-08","kind":"meta","colSpan":5}],
        [{"ref":"A3","role":"e"},{"text":"金额单位：元","kind":"meta","colSpan":5}],
        [{"text":"被审核人"},{"ref":"B4","role":"f"},{"text":"编制人"},{"ref":"D4","role":"f"},{"text":"编制日期"},{"ref":"F4","role":"f"}],
        [{"text":"会计期间"},{"ref":"B5","role":"f"},{"text":"复核人"},{"ref":"D5","role":"f"},{"text":"复核日期"},{"ref":"F5","role":"f"}],
        [{"text":"一、初步业务活动目标","colSpan":6}],
        [{"text":"（一）确定是否接受业务委托。","colSpan":6}],
        [{"text":"（二）如接受业务委托，确保在计划审核工作时达到下列要求：","colSpan":6}],
        [{"text":"1.注册税务师已具备执行业务所需要的独立性和专业胜任能力。","colSpan":6}],
        [{"text":"2.不存在因管理层诚信问题而影响注册税务师承接或保持该项业务意愿的情况。","colSpan":6}],
        [{"text":"3.与被审核单位不存在对业务约定条款的误解。","colSpan":6}],
        [{"text":"二、初步业务活动程序","colSpan":6}],
        [{"text":"（一）如果首次接受审核委托，实施下列程序：","colSpan":4},{"text":"执行情况","colSpan":2}],
        [{"text":"1.与委托人面谈，讨论下列事项：","colSpan":4},{"colSpan":2,"ref":"E14","role":"e"}],
        [{"text":"（1）审核的目标。","colSpan":4},{"colSpan":2,"ref":"E15","role":"e"}],
        [{"text":"（2）审核报告的用途。","colSpan":4},{"colSpan":2,"ref":"E16","role":"e"}],
        [{"text":"（3）管理层对纳税申报表的责任。","colSpan":4},{"colSpan":2,"ref":"E17","role":"e"}],
        [{"text":"（4）审核范围。","colSpan":4},{"colSpan":2,"ref":"E18","role":"e"}],
        [{"text":"（5）执行审核工作的安排，包括出具审核报告的时间要求。","colSpan":4},{"colSpan":2,"ref":"E19","role":"e"}],
        [{"text":"（6）审核报告格式和对审核结果的其他沟通形式。","colSpan":4},{"colSpan":2,"ref":"E20","role":"e"}],
        [{"text":"（7）管理层提供必要的工作条件和协助。","colSpan":4},{"colSpan":2,"ref":"E21","role":"e"}],
        [{"text":"（8）注册税务师不受限制地接触任何与审核有关的记录、文件和所需要的其他信息。","colSpan":4},{"colSpan":2,"ref":"E22","role":"e"}],
        [{"text":"（9）与审核涉及的内部审核人员和客户其他员工工作的协凋（必要时）。","colSpan":4},{"colSpan":2,"ref":"E23","role":"e"}],
        [{"text":"（10）审核收费，包括费用的计算基础和收费安排。","colSpan":4},{"colSpan":2,"ref":"E24","role":"e"}],
        [{"text":"2.初步了解客户及其环境，进行初步业务税务风险评估并予以记录。","colSpan":4},{"colSpan":2,"ref":"E25","role":"e"}],
        [{"text":"3.征得被审核单位书面同意后，与前任注册税务师沟通。","colSpan":4},{"colSpan":2,"ref":"E26","role":"e"}],
        [{"text":"（二）如果是连续审核，实施下列程序：","colSpan":4},{"colSpan":2,"ref":"E27","role":"e"}],
        [{"text":"1.了解审核的目标，审核报告的用途，审核范围和时间安排等是否发生变化。","colSpan":4},{"colSpan":2,"ref":"E28","role":"e"}],
        [{"text":"2.查阅以前年度审核工作底稿，重点关注非标准审核报告、管理建议书和重大事项概要等。","colSpan":4},{"colSpan":2,"ref":"E29","role":"e"}],
        [{"text":"3.初步了解被审核单位及其环境发生的重大变化，进行初步税务风险评估并予以记录。","colSpan":4},{"colSpan":2,"ref":"E30","role":"e"}],
        [{"text":"4.考虑是否需要修改业务约定条款，是否需要提醒客户注意现有的业务约定条款。","colSpan":4},{"colSpan":2,"ref":"E31","role":"e"}],
        [{"text":"（三）评价是否具备执行该项审核业务所需要的独立性和专业胜任能力。","colSpan":4},{"colSpan":2,"ref":"E32","role":"e"}],
        [{"text":"（四）完成业务承接/业务保持评价表。","colSpan":4},{"colSpan":2,"ref":"E33","role":"e"}],
        [{"text":"（五）签订审核业务约定书（适用于首次接受业务委托，以及连续审核中修改长期审核业务约定书条款的情况）。","colSpan":4},{"colSpan":2,"ref":"E34","role":"e"}]
      ]
    }
  ]
}
