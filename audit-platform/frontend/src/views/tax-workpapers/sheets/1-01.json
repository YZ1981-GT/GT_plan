        [{"text":"23","kind":"number"},{"text":"减：稽查查补（退）所得税额","colSpan":4},{"kind":"number","colSpan":2,"ref":"F39","role":"f","fmt":"money"}],
        [{"text":"24","kind":"number"},{"text":"减：特别纳税调整补（退）所得税额","colSpan":4},{"kind":"number","colSpan":2,"ref":"F40","role":"f","fmt":"money"}],
        [{"text":"25","kind":"number"},{"text":"八、本年实际应补（退）所得税额","colSpan":4},{"kind":"number","colSpan":2,"ref":"F41","role":"f","fmt":"money"}],
        [{"text":"注：具体纳税调整项目及说明详见附件《企业所得税年度纳税申报审核报告说明》。","colSpan":7}],
        [{"colSpan":7}],
        [{"colSpan":7}],
        [{"text":"本报告仅供被审核单位向主管税务机关办理企业所得税年度纳税申报时使用，不作其他用途。因使用不当造成的后果，与执行本审核业务的税务师事务所及其税务师无关。","colSpan":7}],
