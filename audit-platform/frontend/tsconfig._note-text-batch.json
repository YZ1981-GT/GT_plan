    "src/components/disclosure/NoteDocUploadDialog.vue",
    "src/components/disclosure/NoteContentTemplateApplyDialog.vue",
    "src/components/disclosure/NoteContentTemplatePicker.vue",
    "src/components/disclosure/NoteContentTemplateSaveDialog.vue",
    "src/components/disclosure/DisclosureNoteContentTools.vue",
